{
  "name": "meta-lens",
  "displayName": "meta-lens",
  "description": "Understand any Yocto repo in minutes: layers, recipes, bbappends and overlay chains, from static analysis only.",
  "version": "0.0.1",
  "publisher": "oliviertanoh",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "yocto",
    "openembedded",
    "bitbake",
    "bbappend",
    "embedded linux"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/conf/layer.conf",
    "workspaceContains:**/conf/bblayers.conf",
    "workspaceContains:**/kas*.yml",
    "workspaceContains:**/kas/*.yml"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "metaLens",
          "title": "meta-lens",
          "icon": "media/activitybar.svg"
        }
      ],
      "activitybar": [
        {
          "id": "metaLensLeft",
          "title": "meta-lens",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "metaLens": [
        {
          "type": "webview",
          "id": "metaLens.sidebar",
          "name": "meta-lens",
          "when": "!metaLens.useLeftSidebar"
        }
      ],
      "metaLensLeft": [
        {
          "type": "webview",
          "id": "metaLens.sidebarLeft",
          "name": "meta-lens",
          "when": "metaLens.useLeftSidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "meta-lens.open",
        "title": "Open meta-lens",
        "category": "meta-lens",
        "icon": {
          "light": "media/logo-color.svg",
          "dark": "media/logo-color.svg"
        }
      },
      {
        "command": "meta-lens.refresh",
        "title": "Refresh",
        "category": "meta-lens",
        "icon": "$(refresh)"
      },
      {
        "command": "meta-lens.filterRecipes",
        "title": "Filter Recipes",
        "category": "meta-lens",
        "icon": "$(filter)"
      },
      {
        "command": "meta-lens.filterAppends",
        "title": "Toggle Has appends Filter",
        "category": "meta-lens"
      },
      {
        "command": "meta-lens.showAllRecipes",
        "title": "Show All Recipes (including upstream layers)",
        "category": "meta-lens",
        "icon": "$(layers)"
      },
      {
        "command": "meta-lens.showProjectRecipes",
        "title": "Show Project Recipes Only",
        "category": "meta-lens",
        "icon": "$(home)"
      },
      {
        "command": "meta-lens.showOverlayChain",
        "title": "Show Overlay Chain",
        "category": "meta-lens",
        "icon": "$(git-merge)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "meta-lens.refresh",
          "when": "view == metaLens.sidebar || view == metaLens.sidebarLeft",
          "group": "navigation@1"
        },
        {
          "command": "meta-lens.filterRecipes",
          "when": "view == metaLens.sidebar || view == metaLens.sidebarLeft",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "meta-lens.open",
          "when": "metaLens.hasProject && config.metaLens.showEditorButton",
          "group": "navigation@100"
        },
        {
          "command": "meta-lens.showOverlayChain",
          "when": "resourceExtname == .bb || resourceExtname == .bbappend",
          "group": "navigation@101"
        }
      ],
      "commandPalette": [
        {
          "command": "meta-lens.showOverlayChain",
          "when": "resourceExtname == .bb || resourceExtname == .bbappend"
        }
      ]
    },
    "configuration": {
      "title": "meta-lens",
      "properties": {
        "metaLens.excludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directory names to skip when scanning the workspace (build/, tmp/, sstate-cache/, downloads/ and .git/ are always skipped)."
        },
        "metaLens.projectLayers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Layer directory names that belong to your project (e.g. `meta-mycompany`). When empty, meta-lens guesses: well-known community layers and layers in a nested git checkout are upstream, the rest is yours. The RECIPES view shows only recipes created or extended by project layers by default."
        },
        "metaLens.location": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "enumDescriptions": [
            "Secondary Side Bar, next to chat views (VS Code 1.106 or later).",
            "Activity Bar on the left."
          ],
          "default": "right",
          "description": "Where the meta-lens panel lives."
        },
        "metaLens.showEditorButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the meta-lens logo in the editor title bar when a Yocto project is open."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node esbuild.mjs && tsc -p test/e2e/tsconfig.json",
    "test:e2e": "node out/e2e/test/e2e/runTest.js",
    "check": "tsc --noEmit && eslint src test && prettier --check . && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
